import os
import numpy as np
import matplotlib.pyplot as plt

# ============================================================
# USER SETTINGS
# ============================================================
OUT_DIR = r"C:/Users/sebsa/Desktop/FYP/Actual Report/figures/Code/Morph"
BASENAME = "Circular_morph"

CHORD_MM = 400.0
TC = 0.12
N_POINTS = 700
COSINE_SPACING = True
CLOSED_TE = True

HINGE_FRAC = 0.50

# Input is EFFECTIVE deflection angle: line from (xh,0) to morphed TE
DEFLECT_EFF_DEG = 30.0   # positive = down

# Curvature ramp power p (>=0): p=0 circular-arc-like, p=1 clothoid-like
CURVATURE_POWER = 0.0

# Aft centerline resolution
N_AFT = 600

# Plot
FIG_DPI = 300
SAVE_PNG = True


# ============================================================
# Helpers
# ============================================================
def format_angle_filename(angle_deg: float) -> str:
    if float(angle_deg).is_integer():
        return f"{int(angle_deg)}deg"
    return f"{angle_deg:.1f}".replace(".", "p") + "deg"


# ============================================================
# Geometry helpers
# ============================================================
def cosine_x(n: int) -> np.ndarray:
    beta = np.linspace(0.0, np.pi, n)
    return 0.5 * (1.0 - np.cos(beta))


def naca_thickness(x_over_c: np.ndarray, tc: float, closed_te: bool) -> np.ndarray:
    a0, a1, a2, a3 = 0.2969, -0.1260, -0.3516, 0.2843
    a4 = -0.1036 if closed_te else -0.1015
    x = np.clip(x_over_c, 0.0, 1.0)
    return 5.0 * tc * (a0*np.sqrt(x) + a1*x + a2*x**2 + a3*x**3 + a4*x**4)


def cumtrapz(y: np.ndarray, x: np.ndarray) -> np.ndarray:
    out = np.zeros_like(y, dtype=float)
    dx = np.diff(x)
    out[1:] = np.cumsum(0.5 * (y[1:] + y[:-1]) * dx)
    return out


def make_closed_loop(xu, yu, xl, yl):
    return (
        np.concatenate([xu[::-1], xl[1:]]),
        np.concatenate([yu[::-1], yl[1:]]),
    )


# ============================================================
# Aft centerline: curvature-ramp, NO STRETCH, effective-angle control
# ============================================================
def _aft_centerline_from_theta_end(xh: float, c: float, theta_end: float, p: float, n: int):
    S = c - xh
    u = np.linspace(0.0, 1.0, n)
    s = u * S

    theta = theta_end * (u ** (p + 1.0))
    kappa = (theta_end / max(S, 1e-12)) * (p + 1.0) * (u ** p)

    x = xh + cumtrapz(np.cos(theta), s)
    y = cumtrapz(np.sin(theta), s)
    return u, x, y, theta, kappa


def aft_centerline_eff_angle(xh: float, c: float, eff_deflect_deg: float, p: float, n: int, iters: int = 60):
    alpha_target = -np.deg2rad(eff_deflect_deg)
    p = max(float(p), 0.0)

    def eff_angle(theta_end):
        u, x, y, theta, kappa = _aft_centerline_from_theta_end(xh, c, theta_end, p, max(400, n // 2))
        return np.arctan2(y[-1], x[-1] - xh), (u, x, y, theta, kappa)

    th_lo, th_hi = -np.deg2rad(89.0), -1e-6
    a_lo, _ = eff_angle(th_lo)
    a_hi, _ = eff_angle(th_hi)

    if not (min(a_lo, a_hi) <= alpha_target <= max(a_lo, a_hi)):
        theta_end = th_lo if abs(alpha_target - a_lo) < abs(alpha_target - a_hi) else th_hi
        _, pack = eff_angle(theta_end)
        u, x, y, theta, kappa = pack
        return u, x, y, theta, kappa, np.rad2deg(np.arctan2(y[-1], x[-1] - xh)), np.rad2deg(theta_end)

    for _ in range(iters):
        th_mid = 0.5 * (th_lo + th_hi)
        a_mid, _ = eff_angle(th_mid)
        if (a_lo - alpha_target) * (a_mid - alpha_target) <= 0:
            th_hi, a_hi = th_mid, a_mid
        else:
            th_lo, a_lo = th_mid, a_mid

    theta_end = 0.5 * (th_lo + th_hi)
    u, x, y, theta, kappa = _aft_centerline_from_theta_end(xh, c, theta_end, p, n)
    eff_angle_deg = np.rad2deg(np.arctan2(y[-1], x[-1] - xh))
    theta_end_deg = np.rad2deg(theta_end)
    return u, x, y, theta, kappa, eff_angle_deg, theta_end_deg


# ============================================================
# Build morphed airfoil by mapping aft region via u=(x-xh)/(c-xh)
# ============================================================
def build_airfoil_from_centerline(x_over_c, c, xh, yt, u_cl, x_cl, y_cl, th_cl):
    x_base = x_over_c * c
    aft = x_base >= xh
    L = max(c - xh, 1e-12)

    xC = np.empty_like(x_base)
    yC = np.empty_like(x_base)
    th = np.empty_like(x_base)

    xC[~aft] = x_base[~aft]
    yC[~aft] = 0.0
    th[~aft] = 0.0

    u_aft = np.clip((x_base[aft] - xh) / L, 0.0, 1.0)
    xC[aft] = np.interp(u_aft, u_cl, x_cl)
    yC[aft] = np.interp(u_aft, u_cl, y_cl)
    th[aft] = np.interp(u_aft, u_cl, th_cl)

    xu = xC - yt * np.sin(th)
    yu = yC + yt * np.cos(th)
    xl = xC + yt * np.sin(th)
    yl = yC - yt * np.cos(th)

    return xu, yu, xl, yl


# ============================================================
# MAIN
# ============================================================
def main():
    c = float(CHORD_MM)
    xh = HINGE_FRAC * c

    x_over_c = cosine_x(N_POINTS) if COSINE_SPACING else np.linspace(0.0, 1.0, N_POINTS)
    x_base = x_over_c * c

    yt = naca_thickness(x_over_c, TC, CLOSED_TE) * c
    yt[0] = 0.0
    yt[-1] = 0.0

    xu0, yu0 = x_base.copy(), +yt
    xl0, yl0 = x_base.copy(), -yt
    xb, yb = make_closed_loop(xu0, yu0, xl0, yl0)

    u_cl, x_cl, y_cl, th_cl, kappa_cl, eff_deg_ach, theta_end_deg = aft_centerline_eff_angle(
        xh=xh, c=c, eff_deflect_deg=DEFLECT_EFF_DEG, p=CURVATURE_POWER, n=N_AFT
    )

    xu, yu, xl, yl = build_airfoil_from_centerline(
        x_over_c=x_over_c, c=c, xh=xh, yt=yt,
        u_cl=u_cl, x_cl=x_cl, y_cl=y_cl, th_cl=th_cl
    )
    xm, ym = make_closed_loop(xu, yu, xl, yl)

    x_te, y_te = x_cl[-1], y_cl[-1]
    eff_line_deg = np.rad2deg(np.arctan2(y_te, x_te - xh))

    print(f"Effective deflection target: {-DEFLECT_EFF_DEG:.2f} deg (down)")
    print(f"Effective deflection achieved (xh->TE line): {eff_line_deg:.2f} deg")
    print(f"Solved end tangent angle theta_end: {theta_end_deg:.2f} deg")
    print(f"TE (centerline): x={x_te:.3f} mm, y={y_te:.3f} mm")

    plt.rcParams.update({
        "font.size": 14,
        "axes.labelsize": 16,
        "axes.titlesize": 16,
        "legend.fontsize": 13,
        "xtick.labelsize": 13,
        "ytick.labelsize": 13,
    })

    fig, ax = plt.subplots(figsize=(10, 5.2))
    ax.set_aspect("equal", adjustable="box")

    ax.plot(xb, yb, linewidth=2.0, label="Baseline airfoil")
    ax.plot(xm, ym, linewidth=2.0, label=fr"Morphed airfoil ({DEFLECT_EFF_DEG:.0f}$^\circ$)")
    ax.plot(x_cl, y_cl, "--", linewidth=1.6, label="Morphed centreline")
    ax.plot([xh, x_te], [0.0, y_te], "-.", linewidth=1.8,
            label=fr"Effective deflection line ({abs(eff_line_deg):.1f}$^\circ$)")

    ax.set_xlabel("Chordwise position, x [mm]")
    ax.set_ylabel("Vertical position, y [mm]")
    ax.grid(True, linewidth=0.6, alpha=0.35)

    x_all = np.concatenate([xb, xm, x_cl, np.array([xh, x_te])])
    y_all = np.concatenate([yb, ym, y_cl, np.array([0.0, y_te])])

    x_min = np.min(x_all)
    x_max = np.max(x_all)
    y_min = np.min(y_all)
    y_max = np.max(y_all)

    x_range = x_max - x_min
    y_range = y_max - y_min

    ax.set_xlim(x_min - 0.03 * x_range, x_max + 0.05 * x_range)

    top_pad = max(1.1 * y_range, 75.0)
    bottom_pad = 0.10 * y_range
    ax.set_ylim(y_min - bottom_pad, y_max + top_pad)

    ax.legend(
        loc="upper right",
        bbox_to_anchor=(0.98, 0.95),
        frameon=True,
        borderaxespad=0.6
    )

    plt.tight_layout()

    if SAVE_PNG:
        os.makedirs(OUT_DIR, exist_ok=True)
        angle_tag = format_angle_filename(DEFLECT_EFF_DEG)
        fig_path = os.path.join(OUT_DIR, f"{angle_tag}.png")
        plt.savefig(fig_path, dpi=FIG_DPI, bbox_inches="tight")
        print("Plot saved:", fig_path)

    plt.show()


if __name__ == "__main__":
    main()
