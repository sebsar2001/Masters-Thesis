from pathlib import Path
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# ============================================================
# USER SETTINGS
# ============================================================
BASE_DIR = Path(r"C:/Users/sebsa/Desktop/Abaqus-Work/FYP2/pressure_extracted")
SUMMARY_CSV = BASE_DIR / "pressure_batch_summary.csv"
OUT_DIR = BASE_DIR / "plots"

# Abaqus mm-N unit system
STRESS_TO_MPA = 1.0

# Force selected y-axis plots to start at zero
START_AT_ZERO_PLOTS = {
    "Actuator reaction force [N]": True,
    "Actuator displacement [mm]": True,
    "Spring max von Mises stress [MPa]": True,
    "Spring max principal stress [MPa]": True,
    "Spring max principal strain [mm/mm]": True,
}

# ============================================================
# THESIS PLOT STYLE
# ============================================================
plt.rcParams.update({
    "font.family": "serif",
    "font.serif": ["Times New Roman", "Times", "DejaVu Serif"],
    "mathtext.fontset": "dejavuserif",
})

FIG_W = 10.0
FIG_H = 8.0
LABEL_FS = 28
TICK_FS = 22
LEGEND_FS = 18
OFFSET_FS = 20
LINE_W = 2.8
MARKER_SZ = 8
SPINE_W = 1.8
TICK_LEN = 9
TICK_W = 1.8

# ============================================================
# HELPERS
# ============================================================
def ensure_dir(path: Path):
    path.mkdir(parents=True, exist_ok=True)

def style_axes(ax):
    ax.grid(True, which="major", linewidth=0.8, alpha=0.35)
    ax.tick_params(
        axis="both",
        labelsize=TICK_FS,
        direction="in",
        top=True,
        right=True,
        length=TICK_LEN,
        width=TICK_W,
        pad=8
    )
    for spine in ax.spines.values():
        spine.set_linewidth(SPINE_W)

    ax.xaxis.get_offset_text().set_fontsize(OFFSET_FS)
    ax.yaxis.get_offset_text().set_fontsize(OFFSET_FS)

def load_summary(path: Path) -> pd.DataFrame:
    if not path.exists():
        raise FileNotFoundError(f"Missing summary CSV: {path}")

    df = pd.read_csv(path)

    numeric_cols = [
        "Angle_deg",
        "RP_U1", "RP_U2", "RP_RF1", "RP_RF2",
        "TE_U1", "TE_U2",
        "Upper_U1", "Upper_U2",
        "Lower_U1", "Lower_U2",
        "Spring_MaxMises", "Spring_MaxPrincipalStress", "Spring_MaxPrincipalStrain",
    ]

    for col in numeric_cols:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    if "Angle_deg" in df.columns:
        df = df.sort_values("Angle_deg").reset_index(drop=True)

    if "RP_RF1" in df.columns and "RP_RF2" in df.columns:
        df["RP_RF_Mag"] = np.sqrt(df["RP_RF1"].fillna(0.0)**2 + df["RP_RF2"].fillna(0.0)**2)

    if "RP_U1" in df.columns and "RP_U2" in df.columns:
        df["RP_U_Mag"] = np.sqrt(df["RP_U1"].fillna(0.0)**2 + df["RP_U2"].fillna(0.0)**2)

    if "Spring_MaxMises" in df.columns:
        df["Spring_MaxMises_MPa"] = df["Spring_MaxMises"] * STRESS_TO_MPA

    if "Spring_MaxPrincipalStress" in df.columns:
        df["Spring_MaxPrincipalStress_MPa"] = df["Spring_MaxPrincipalStress"] * STRESS_TO_MPA

    return df

def set_zero_start(ax, y, use_abs):
    y = np.asarray(y, dtype=float)
    if y.size == 0:
        return

    ymin = np.nanmin(y)
    ymax = np.nanmax(y)

    if use_abs or ymin >= 0.0:
        ax.set_ylim(bottom=0.0)
    elif ymax <= 0.0:
        ax.set_ylim(top=0.0)

def make_line_plot(df, xcol, ycol, xlabel, ylabel, out_path, use_abs=False, start_at_zero=False):
    x = pd.to_numeric(df[xcol], errors="coerce")
    y = pd.to_numeric(df[ycol], errors="coerce")

    mask = ~(x.isna() | y.isna())
    x = x[mask]
    y = y[mask]

    if use_abs:
        y = y.abs()

    fig, ax = plt.subplots(figsize=(FIG_W, FIG_H))
    ax.plot(
        x,
        y,
        linewidth=LINE_W,
        marker="o",
        markersize=MARKER_SZ
    )

    ax.set_xlabel(xlabel, fontsize=LABEL_FS)
    ax.set_ylabel(ylabel, fontsize=LABEL_FS)

    if start_at_zero:
        set_zero_start(ax, y, use_abs)

    style_axes(ax)

    # Much larger left margin for long y-axis labels
    fig.subplots_adjust(left=0.15, bottom=0.15, right=0.97, top=0.95)

    fig.savefig(out_path, dpi=300)
    plt.close(fig)

# ============================================================
# MAIN
# ============================================================
def main():
    ensure_dir(OUT_DIR)
    df = load_summary(SUMMARY_CSV)

    plot_specs = [
        ("RP_RF_Mag", "Deflection angle [deg]", "Actuator reaction force [N]",
         "actuator_reaction_force_vs_deflection_angle.png", True),

        ("RP_U_Mag", "Deflection angle [deg]", "Actuator displacement [mm]",
         "actuator_displacement_vs_deflection_angle.png", True),

        ("Spring_MaxMises_MPa", "Deflection angle [deg]", "Spring max von Mises stress [MPa]",
         "spring_max_von_mises_vs_deflection_angle.png", False),

        ("Spring_MaxPrincipalStress_MPa", "Deflection angle [deg]", "Spring max principal stress [MPa]",
         "spring_max_principal_stress_vs_deflection_angle.png", False),

        ("Spring_MaxPrincipalStrain", "Deflection angle [deg]", "Spring max principal strain [mm/mm]",
         "spring_max_principal_strain_vs_deflection_angle.png", False),

        ("TE_U2", "Deflection angle [deg]", "Trailing-edge vertical displacement [mm]",
         "te_vertical_displacement_vs_deflection_angle.png", False),

        ("Upper_U2", "Deflection angle [deg]", "Upper surface vertical displacement [mm]",
         "upper_surface_vertical_displacement_vs_deflection_angle.png", False),

        ("Lower_U2", "Deflection angle [deg]", "Lower surface vertical displacement [mm]",
         "lower_surface_vertical_displacement_vs_deflection_angle.png", False),
    ]

    for ycol, xlabel, ylabel, filename, use_abs in plot_specs:
        if ycol in df.columns and df[ycol].notna().any():
            make_line_plot(
                df=df,
                xcol="Angle_deg",
                ycol=ycol,
                xlabel=xlabel,
                ylabel=ylabel,
                out_path=OUT_DIR / filename,
                use_abs=use_abs,
                start_at_zero=START_AT_ZERO_PLOTS.get(ylabel, False)
            )

    print("Done.")
    print(f"Plots written to: {OUT_DIR}")

if __name__ == "__main__":
    main()
