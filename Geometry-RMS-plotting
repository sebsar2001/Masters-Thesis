OUT_DIR = Path(r"C:/Users/sebsa/Desktop/Abaqus-Work/FYP2/centerline_rms_out")

# Geometry scales
FEA_CHORD_MM = 500.0
TARGET_CHORD_MM = 400.0
SCALE_FEA_TO_TARGET = TARGET_CHORD_MM / FEA_CHORD_MM   # 0.8

TARGET_FILES = {
    "5DEG":  "Circular_morph_5.0deg.txt",
    "10DEG": "Circular_morph_10.0deg.txt",
    "15DEG": "Circular_morph_15.0deg.txt",
    "20DEG": "Circular_morph_20.0deg.txt",
    "25DEG": "Circular_morph_25.0deg.txt",
    "30DEG": "Circular_morph_30.0deg.txt",
}

# Target-airfoil skin-covered region, defined on TARGET chord
UPPER_SEGMENT_XC = (0.525, 0.94)
LOWER_SEGMENT_XC = (0.500, 0.94)

# Alignment for centerline comparison:
# "none"      -> raw comparison
# "start"     -> match first point only
# "two_point" -> remove linear offset between first and last point
ALIGNMENT_MODE = "start"

# Plot styling
FIG_W = 7.0
FIG_H = 4.8
LABEL_FS = 14
TICK_FS = 13
LEGEND_FS = 11
LINE_W = 2.0
MARKER_SZ = 3

SAVE_PLOTS = True
SAVE_POINTWISE_CSVS = True

# Summary plot settings
